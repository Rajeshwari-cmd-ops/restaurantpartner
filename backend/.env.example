# Backend Environment Variables Template
# Copy to .env for local development or set in your cloud host (e.g. Render, Railway)

PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/forge_india_connect
JWT_SECRET=your_secure_random_jwt_secret_key_here
CORS_ORIGIN=https://your-frontend.vercel.app
